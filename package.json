{
  "name": "wav-player",
  "version": "1.0.0",
  "description": "一个简单易用的 WAV 播放器，支持同步字幕与本地日文转中文。",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunyun0233/wav-player.git"
  },
  "homepage": "https://github.com/sunyun0233/wav-player",
  "bugs": {
    "url": "https://github.com/sunyun0233/wav-player/issues"
  },
  "keywords": [
    "electron",
    "wav",
    "player",
    "vtt",
    "subtitle",
    "faster-whisper",
    "whisper",
    "japanese-to-chinese",
    "ark-ui",
    "exa"
  ],
  "scripts": {
    "start": "electron .",
    "test": "node test/embedded-cover.test.js",
    "pack": "electron-builder --win dir",
    "pack:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.wavplayer",
    "productName": "WAV Player",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "library.js",
      "embedded-cover.js",
      "transcribe.js",
      "transcribe.py",
      "renderer/**"
    ],
    "asarUnpack": [
      "transcribe.py",
      "transcribe.js"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "WavPlayer-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
